# 运动比赛竞赛系统环境变量配置示例
# 复制此文件为.env并根据您的环境进行修改
# 部署到互联网时，请创建.env.production文件并适当配置

# 应用环境
# development - 开发环境
# production - 生产环境
NODE_ENV=development

# 服务器端口
PORT=5000

# MongoDB连接字符串
# 格式：mongodb://[username:password@]host[:port]/database
# 本地开发环境
MONGO_URI=mongodb://localhost:27017/competition-system
# 生产环境示例 (请替换用户名、密码和主机)
# MONGO_URI=mongodb://username:password@host:port/competition-system
# Docker环境
# MONGO_URI=mongodb://mongo:27017/competition-system

# JWT配置
# 生产环境中请使用强密钥，可通过以下命令生成:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# 文件上传配置
FILE_UPLOAD_PATH=./public/uploads
MAX_FILE_UPLOAD=1000000 # 1MB

# 跨域配置 (生产环境中特别重要)
# 允许的来源，多个来源用逗号分隔
# CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
# 允许所有来源 (不推荐用于生产环境)
# CORS_ORIGIN=*